{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "markdown-can-do-legacy-redirect",
  "main": "./scripts/redirect-worker.mjs",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "md.aicando.xyz",
      "custom_domain": true
    }
  ]
}
