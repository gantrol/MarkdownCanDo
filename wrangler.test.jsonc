{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "markdown-can-do-test",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "IMAGE_UPLOADS",
      "bucket_name": "markdown-can-do-uploads-test"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "IMAGE_QUOTA",
        "class_name": "ImageQuota"
      }
    ]
  },
  "exports": {
    "ImageQuota": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "IMAGE_QUOTA_SECRET": "test-only-quota-secret-with-at-least-32-characters",
    "IMAGE_MAX_BYTES": 5242880,
    "IMAGE_DAILY_CLIENT_BYTES": 20971520,
    "IMAGE_DAILY_CLIENT_FILES": 10,
    "IMAGE_DAILY_SITE_BYTES": 1073741824,
    "IMAGE_DAILY_SITE_FILES": 300,
    "IMAGE_QUOTA_WINDOW_DAYS": 3,
    "IMAGE_ROLLING_STORAGE_BYTES": 4294967296,
    "IMAGE_RETENTION_DAYS": 1
  }
}
