{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "component/MarkdownEditor.vue",
    "component/MarkdownWysiwyg.vue",
    "component/editor/**/*.vue",
    "component/editor/**/*.ts",
    "utils/i18n.ts",
    "utils/imageUpload.ts",
    "utils/markdown.ts",
    "utils/markdownLink.ts",
    "utils/mermaid.ts",
    "types/client-shims.d.ts"
  ]
}
