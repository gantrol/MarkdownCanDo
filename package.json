{
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vitepress build",
    "test": "vitest run",
    "typecheck": "pnpm typecheck:client && pnpm typecheck:worker",
    "typecheck:client": "vue-tsc -p tsconfig.client.json --noEmit",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "types:worker": "wrangler types worker-configuration.d.ts",
    "types:worker:check": "wrangler types worker-configuration.d.ts --check",
    "preview": "vitepress preview",
    "cloudflare:deploy": "pnpm build && wrangler deploy",
    "cloudflare:deploy:dry": "pnpm build && wrangler deploy --dry-run",
    "cloudflare:dev": "pnpm build && wrangler dev",
    "cloudflare:redirect:deploy": "wrangler deploy --config wrangler.redirect.jsonc",
    "cloudflare:redirect:dry": "wrangler deploy --config wrangler.redirect.jsonc --dry-run",
    "docs:dev": "node scripts/dev.mjs",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview",
    "test:security": "node --test tests/security/xmldom.test.mjs tests/security/math-rendering.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.2",
    "@cloudflare/workers-types": "^5.20260829.1",
    "@lucide/vue": "^1.31.0",
    "@milkdown/crepe": "^7.22.0",
    "@milkdown/kit": "7.22.0",
    "@radix-ui/colors": "^3.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.10.1",
    "abcjs": "^6.7.0",
    "dompurify": "^3.4.13",
    "katex": "^0.18.3",
    "markdown-it": "^14.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mathjax3": "^4.3.2",
    "markdown-it-task-checkbox": "^1.0.6",
    "mermaid": "^11.16.1",
    "typescript": "5.9.3",
    "vitepress": "^1.6.4",
    "vitest": "4.1.0",
    "vue": "^3.5.41",
    "vue-tsc": "3.3.11",
    "wrangler": "^4.121.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ],
    "overrides": {
      "@xmldom/xmldom": "0.9.12",
      "undici@>=7.0.0 <7.29.1": "7.29.1",
      "vite": "6.4.3"
    }
  }
}
