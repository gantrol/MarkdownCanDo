{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "worker/**/*.ts",
    "worker-configuration.d.ts",
    "types/worker-env.d.ts"
  ],
  "exclude": [
    "worker/**/*.test.ts"
  ]
}
